# ETEA Prep Library — Next.js (v3)
# Copy to .env.local and fill in. NEVER commit a real key.
# GEMINI_API_KEY is already set in the Vercel project (Production).
# GROQ_API_KEY is optional: when set, Groq is used as fallback if Gemini fails.
# OPENROUTER_API_KEY is optional: when set, OpenRouter (free model only) is
# used as the third fallback if Gemini and Groq both fail.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
